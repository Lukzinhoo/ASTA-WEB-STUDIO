app.get("/api/missions", (req, res) => {
  const missions = db.prepare(`
    SELECT
      id, title, category, description,
      technologies, image, website, github, created_at
    FROM missions
    WHERE status = 'published'
    ORDER BY created_at DESC, id DESC
  `).all();

  res.json({ missions });
});

// ==========================================
// UPLOAD DE IMAGENS
// ==========================================

app.post(
  "/api/admin/upload-image",
  exigirAdmin,
  express.raw({
    type: ["image/png", "image/jpeg", "image/webp"],
    limit: "5mb"
  }),
  (req, res) => {
    const buffer = req.body;

    if (
      !Buffer.isBuffer(buffer) ||
      buffer.length === 0
    ) {
      return res.status(400).json({
        error: "Selecione uma imagem PNG, JPG ou WebP."
      });
    }

    let extensao = "";

    if (
      buffer.length >= 8 &&
      buffer.subarray(0, 8).equals(
        Buffer.from("89504e470d0a1a0a", "hex")
      )
    ) {
      extensao = "png";
    } else if (
      buffer.length >= 3 &&
      buffer[0] === 0xff &&
      buffer[1] === 0xd8 &&
      buffer[2] === 0xff
    ) {
      extensao = "jpg";
    } else if (
      buffer.length >= 12 &&
      buffer.toString("ascii", 0, 4) === "RIFF" &&
      buffer.toString("ascii", 8, 12) === "WEBP"
    ) {
      extensao = "webp";
    }

    if (!extensao) {
      return res.status(400).json({
        error: "Formato de imagem inválido."
      });
    }

    const pasta = path.join(ROOT, "assets", "uploads");

    fs.mkdirSync(pasta, { recursive: true });

    const nome = `${crypto.randomUUID()}.${extensao}`;

    fs.writeFileSync(
      path.join(pasta, nome),
      buffer,
      { flag: "wx" }
    );

    res.status(201).json({
      success: true,
      image: `/assets/uploads/${nome}`
    });
  }
);

// ==========================================
// CAPTURAS AUTOMÁTICAS
// ==========================================

const capturasEmAndamento = new Set();

app.post(
  "/api/admin/missions/:id/refresh-preview",
  exigirAdmin,
  async (req, res) => {
    const id = idValido(req.params.id);

    if (!id) {
      return res.status(400).json({
        error: "ID inválido."
      });
    }

    const missao = db.prepare(`
      SELECT *
      FROM missions
      WHERE id = ?
    `).get(id);

    if (!missao) {
      return res.status(404).json({
        error: "Missão não encontrada."
      });
    }

    if (!missao.website?.trim()) {
      return res.status(400).json({
        error: "Cadastre primeiro o link do site nesta missão."
      });
    }

    if (capturasEmAndamento.has(id)) {
      return res.status(409).json({
        error: "Já existe uma captura em andamento."
      });
    }

    capturasEmAndamento.add(id);

    const pasta = path.join(ROOT, "assets", "uploads");
    const nome = `${crypto.randomUUID()}.png`;
    const arquivo = path.join(pasta, nome);

    try {
      await fs.promises.mkdir(pasta, {
        recursive: true
      });

      await gerarCaptura(missao.website, arquivo);

      const atualizacao = db.prepare(`
        UPDATE missions
        SET
          image = ?,
          updated_at = CURRENT_TIMESTAMP
        WHERE id = ? AND website = ?
      `).run(
        `/assets/uploads/${nome}`,
        id,
        missao.website
      );

      if (!atualizacao.changes) {
        await fs.promises.unlink(arquivo).catch(() => {});

        return res.status(409).json({
          error: "A missão foi alterada. Tente novamente."
        });
      }

      const atualizada = db.prepare(`
        SELECT *
        FROM missions
        WHERE id = ?
      `).get(id);

      return res.json({
        success: true,
        message: "Captura atualizada com sucesso!",
        mission: atualizada
      });
    } catch (error) {
      await fs.promises.unlink(arquivo).catch(() => {});

      console.error("[PREVIEW] Erro:", error);

      return res.status(422).json({
        error: `Não foi possível capturar o site: ${error.message}`
      });
    } finally {
      capturasEmAndamento.delete(id);
    }
  }
);


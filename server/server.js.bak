// ==========================================
// ERROS
// ==========================================

app.use((error, req, res, next) => {
  console.error(error);

  if (error.status === 413) {
    return res.status(413).json({
      error: "Arquivo ou dados muito grandes."
    });
  }

  res.status(500).json({
    error: "Erro interno do servidor."
  });
});

// ==========================================
// CAPTURAS AUTOMÁTICAS
// ==========================================

iniciarCapturas(db, ROOT);

